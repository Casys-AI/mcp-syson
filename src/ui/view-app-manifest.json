      ],
      "acceptedActions": [
        "viewer.session.apply"
      ],
      "sessionSchemas": [
        "io.casys.mcp-syson.recorded-model-children-session/1.0"
      ]
    },
    {
      "uri": "ui://mcp-syson/query-results-viewer",
      "ownership": "whole-view",
      "resultSchemas": [
        "io.casys.mcp-syson.query-result/1.0"
